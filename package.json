{
  "name": "quet-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-web.mjs",
    "dev": "node scripts/build-web.mjs && wrangler dev",
    "deploy": "node scripts/build-web.mjs && wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "migrate:local": "wrangler d1 migrations apply quet-web --local",
    "migrate:remote": "wrangler d1 migrations apply quet-web --remote"
  },
  "dependencies": {
    "hono": "4.13.13",
    "jose": "6.2.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261004.1",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "wrangler": "4.147.0"
  }
}
